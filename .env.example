# Mollie payment provider API key
# Get your key at https://my.mollie.com/dashboard/developers/api-keys
# Use test key (test_xxx) for development, live key (live_xxx) for production
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Turso database
# Get your credentials at https://turso.tech/app
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Mailtrap SMTP (contact form)
# Get your credentials at https://mailtrap.io/inboxes
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass

# Quina Care EMR API (live clinic statistics)
EMR_API_KEY=your-emr-api-key

# CARTO basemap tiles (Putumayo Loop world map)
# Get a key at https://carto.com/basemaps/apikey — restrict it to
# quinacare.org. Free up to 5M tile requests/month; keep the CARTO and
# OpenStreetMap attribution on the map, that is what the free tier is for.
# PUBLIC_ prefix is required: the value is inlined into the client bundle,
# so it is not a secret. In Netlify, do NOT mark it as a secret value.
PUBLIC_CARTO_API_KEY=your-carto-api-key
