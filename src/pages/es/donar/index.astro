---
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import DonationForm from "../../../components/DonationForm.astro";
import AchievedStats from "../../../components/AchievedStats.astro";
import FAQs from "../../../components/FAQs.astro";
import Footer from "../../../components/Footer.astro";
import SocialShare from "../../../components/SocialShare.astro";
import { type Lang, useTranslations } from "../../../i18n";
import { generateQrDataUri } from "../../../lib/qr";

const lang: Lang = "es";
const t = useTranslations(lang);
const qrDataUri = await generateQrDataUri("https://quinacare.org/es/donar");
---

<Layout title="Donar - Quina Care" lang={lang}>
  <Nav />
  <div data-pagefind-body>
    <DonationForm lang={lang} qrDataUri={qrDataUri} />

    <!-- Share donation page QR code -->
    <div class="flex justify-center py-8 border-t border-gray-100">
      <SocialShare
        url="https://quinacare.org/es/donar"
        title={t("donate.pageTitle")}
        lang={lang}
        qrDataUri={qrDataUri}
      />
    </div>
  </div>

  <AchievedStats lang={lang} />
  <FAQs lang={lang} />
  <Footer lang={lang} />
</Layout>
