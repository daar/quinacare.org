---
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import DonationForm from "../../../components/DonationForm.astro";
import AchievedStats from "../../../components/AchievedStats.astro";
import FAQs from "../../../components/FAQs.astro";
import Footer from "../../../components/Footer.astro";
import { type Lang } from "../../../i18n";
import { generateQrDataUri } from "../../../lib/qr";

const lang: Lang = "en";
const qrDataUri = await generateQrDataUri("https://quinacare.org/en/donate");
---

<Layout title="Donate - Quina Care" lang={lang}>
  <Nav />
  <div data-pagefind-body>
    <div class="relative">
      <DonationForm lang={lang} />
      <a
        href={qrDataUri}
        download="quinacare-donate-qr.png"
        class="absolute top-6 left-6 md:top-8 md:left-8 z-20 transition-transform hover:scale-110 active:scale-95"
        aria-label="Download QR code"
      >
        <img
          src={qrDataUri}
          alt="QR code"
          width="120"
          height="120"
          class="w-24 md:w-32 h-24 md:h-32 rounded-lg shadow-lg"
        />
      </a>
    </div>
  </div>

  <AchievedStats lang={lang} />
  <FAQs lang={lang} />
  <Footer lang={lang} />
</Layout>
