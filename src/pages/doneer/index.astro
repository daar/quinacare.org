---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import DonationForm from "../../components/DonationForm.astro";
import AchievedStats from "../../components/AchievedStats.astro";
import FAQs from "../../components/FAQs.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import { useTranslations } from "../../i18n";
import { generateQrDataUri } from "../../lib/qr";

const lang = "nl";
const t = useTranslations(lang);
const qrDataUri = await generateQrDataUri("https://quinacare.org/doneer");
---

<Layout title="Doneer - Quina Care">
  <Nav />
  <div data-pagefind-body>
    <DonationForm />
  </div>

  <div class="max-w-[1600px] mx-auto px-6 py-12">
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm text-center max-w-sm mx-auto">
      <div class="qc-meta mb-4">{t("donate.qrTitle")}</div>
      <img
        src={qrDataUri}
        alt={`${t("donate.qrTitle")} – ${t("nav.donate")}`}
        width="200"
        height="200"
        class="mx-auto rounded-lg"
      />
      <a
        href={qrDataUri}
        download="quinacare-donate-qr.png"
        class="mt-5 flex items-center justify-center gap-2 w-full font-bold text-xs uppercase tracking-widest py-3 rounded-lg border border-gray-200 text-gray-500 hover:border-qcRed hover:text-qcRed transition-colors"
      >
        <Icon name="download" />
        {t("donate.qrDownload")}
      </a>
    </div>
  </div>

  <AchievedStats />
  <FAQs />
  <Footer />
</Layout>
