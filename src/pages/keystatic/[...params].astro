---
// Overrides @keystatic/astro's injected route to add `notranslate` so
// browsers don't auto-translate the (English-only) Keystatic UI chrome,
// e.g. mangling "Save" into "Redden" instead of "Opslaan".
// NOTE: Astro currently only warns about this route colliding with the
// integration's own injected route; a future Astro version may turn that
// into a hard error, so re-check this if `astro check`/build ever fails
// with a route collision on "/keystatic/[...params]".
import { makePage } from "@keystatic/astro/ui";
// @ts-expect-error -- no type declarations for the virtual config module
import config from "virtual:keystatic-config";

const Keystatic = makePage(config);

export const prerender = false;
---

<!doctype html>
<html lang="en" translate="no">
  <head>
    <meta charset="utf-8" />
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Keystatic</title>
  </head>
  <body class="notranslate">
    <Keystatic client:only="react" />
  </body>
</html>
