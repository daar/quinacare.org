---
/**
 * The intake form supporters use to propose their own fundraiser, with a
 * preview beside it that re-renders as they type.
 *
 * The preview is the point of the page. Someone writing a fundraiser has
 * no idea how long a "short summary" should be, or what their title looks
 * like in the real typography, until they see it — and the version they
 * can see is the version they write well. It mirrors the layout of
 * src/pages/acties/[slug].astro closely enough to be honest without
 * pretending to be the page itself: the money and backer counts stay at
 * zero, because nothing has been donated yet.
 *
 * Nothing is published here. Submitting files a GitHub issue (or sends an
 * email) for a maintainer, who writes the actual .mdoc.
 */
import Layout from "../layouts/Layout.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";
import {
  useTranslations,
  getDateLocale,
  getLocalizedPath,
  type Lang,
} from "../i18n";
import { INTAKE_LIMITS } from "../lib/fundraiserIntake";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const dateLocale = getDateLocale(lang);

const helpPath = getLocalizedPath("/start-a-fundraiser", lang);
const privacyPath = getLocalizedPath("/privacy", lang);

// Default the end date three months out: far enough to be plausible, and
// it means the preview shows a sensible countdown before anyone types.
const defaultEnd = new Date();
defaultEnd.setMonth(defaultEnd.getMonth() + 3);
const defaultEndValue = defaultEnd.toISOString().slice(0, 10);
const minEndValue = new Date().toISOString().slice(0, 10);

// Validation messages handed to the client as data, keyed field.code, so
// the script can render a server response without a second copy of the
// translations.
const messages = {
  "title.required": t("intake.errRequired"),
  "organizer.required": t("intake.errRequired"),
  "excerpt.required": t("intake.errRequired"),
  "story.required": t("intake.errRequired"),
  "email.invalid": t("intake.errEmail"),
  "email.required": t("intake.errRequired"),
  "goalAmount.invalid": t("intake.errGoal"),
  "goalAmount.too-large": t("intake.errGoalLarge"),
  "endDate.invalid": t("intake.errDate"),
  "endDate.past": t("intake.errDatePast"),
  "photo.required": t("intake.errPhotoRequired"),
  "photo.type": t("intake.errPhotoType"),
  "photo.too-large": t("intake.errPhotoLarge"),
  "photo.too-small": t("intake.errPhotoSmall"),
  "photo.unreadable": t("intake.errPhotoUnreadable"),
  "attachments.too-many": t("intake.errFilesCount"),
  "attachments.type": t("intake.errFilesType"),
  "attachments.too-large": t("intake.errFilesLarge"),
  fallback: t("intake.errRequired"),
};

const input =
  "w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-qcBlack placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-qcRed/30 focus:border-qcRed transition-all";
const label = "block text-sm font-semibold text-qcBlack";
const hint = "mt-1 mb-2 text-xs text-gray-500 leading-relaxed";
// Group heading: the form's rhythm comes from these, not from one spacing
// value repeated down the column.
const legend =
  "text-[11px] font-bold uppercase tracking-[0.2em] text-gray-400 pr-4";
const groupGap = "mt-14 pt-8 border-t border-gray-100";
const fmtBtn =
  "inline-flex items-center justify-center min-w-9 h-9 px-2.5 rounded-md text-sm text-gray-600 hover:bg-white hover:text-qcRed hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-qcRed/30 transition-all";
---

<Layout title={`${t("intake.heading")} - Quina Care`} lang={lang}>
  <Nav />

  <header class="max-w-6xl mx-auto px-6 pt-32 pb-12">
    <a
      href={getLocalizedPath("/fundraisers", lang)}
      class="qc-meta inline-flex items-center gap-2 hover:text-qcRed transition-colors group"
    >
      <svg
        class="w-4 h-4 group-hover:-translate-x-1 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      {t("fundraise.backToList")}
    </a>

    <h1
      class="mt-6 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter leading-[0.95] uppercase"
    >
      {t("intake.heading")}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-gray-500 leading-relaxed">
      {t("intake.intro")}
    </p>
    <a
      href={helpPath}
      class="mt-6 inline-flex items-center gap-2.5 rounded-lg border border-gray-200 px-5 py-3 text-sm font-semibold text-qcBlack hover:border-qcRed hover:text-qcRed transition-colors"
    >
      <Icon name="book-open" class="text-qcRed" />
      {t("intake.helpLink")}
    </a>
  </header>

  <main class="max-w-6xl mx-auto px-6 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-12">
      <!-- Preview. First on a phone: it is what the page is selling, and
           below a form this long nobody would ever reach it. -->
      <div class="lg:col-span-5 lg:col-start-8 lg:row-start-1">
        <div class="lg:sticky lg:top-28">
          <h2
            class="text-xs font-bold uppercase tracking-[0.2em] text-gray-400"
          >
            {t("intake.previewHeading")}
          </h2>
          <p class="mt-2 mb-4 text-xs text-gray-500 leading-relaxed">
            {t("intake.previewNote")}
          </p>

          <div
            id="preview-card"
            class="preview-scroll relative rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden lg:max-h-[calc(100vh-11rem)] lg:overflow-y-auto"
            data-locale={dateLocale}
          >
            <div class="aspect-video bg-gray-50 relative">
              <img
                id="p-photo"
                alt=""
                class="w-full h-full object-cover opacity-0 transition-opacity duration-500"
              />
              <div
                id="p-photo-empty"
                class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-gray-300"
              >
                <Icon name="photo-film" class="text-3xl" />
                <span class="text-xs">{t("intake.previewPhoto")}</span>
              </div>
            </div>

            <div class="p-6">
              <span
                class="qc-meta bg-emerald-500 !text-white px-3 py-1.5 rounded-full inline-block mb-4"
              >
                {t("fundraise.active")}
              </span>

              <h3
                id="p-title"
                data-empty="true"
                class="preview-slot text-2xl font-bold tracking-tighter leading-tight uppercase break-words"
              >
                {t("intake.previewTitle")}
              </h3>
              <p class="text-sm text-gray-500 mt-2">
                {t("fundraise.campaignBy")}{" "}
                <span
                  id="p-organizer"
                  data-empty="true"
                  class="preview-slot font-bold break-words"
                >
                  {t("intake.previewOrganizer")}
                </span>
              </p>

              <div class="mt-6 pt-6 border-t border-gray-100">
                <div class="w-full bg-gray-100 rounded-full h-3 mb-4">
                  <div
                    class="bg-gradient-to-r from-qcRed to-rose-400 h-3 rounded-full"
                    style="width: 0%"
                  >
                  </div>
                </div>
                <div
                  id="p-raised"
                  class="text-3xl font-bold tracking-tight tabular-nums mb-1"
                >
                  &euro; 0
                </div>
                <p class="text-sm text-gray-500">
                  {
                    /* One expression: adjacent {…} on separate lines lose
                      the space between them when the file is formatted. */
                  }
                  {`${t("fundraise.raised")} ${t("fundraise.of")}`}{" "}
                  <span id="p-goal" class="tabular-nums font-semibold"
                    >&euro; 0</span
                  >{" "}
                  {t("fundraise.goal")}
                </p>

                <div
                  class="grid grid-cols-3 gap-3 py-5 mt-5 border-t border-gray-100"
                >
                  <div>
                    <div class="text-xl font-bold tracking-tight tabular-nums">
                      0%
                    </div>
                    <div class="qc-meta">{t("fundraise.funded")}</div>
                  </div>
                  <div>
                    <div class="text-xl font-bold tracking-tight tabular-nums">
                      0
                    </div>
                    <div class="qc-meta">{t("fundraise.backers")}</div>
                  </div>
                  <div>
                    <div
                      id="p-days"
                      class="text-xl font-bold tracking-tight tabular-nums"
                    >
                      0
                    </div>
                    <div class="qc-meta">{t("fundraise.daysToGo")}</div>
                  </div>
                </div>

                <div
                  class="flex items-center gap-3 pt-4 border-t border-gray-100"
                >
                  <div
                    class="w-10 h-10 rounded-lg bg-gray-50 flex items-center justify-center flex-shrink-0"
                  >
                    <Icon name="calendar" class="text-gray-400" />
                  </div>
                  <div>
                    <div class="qc-meta">{t("fundraise.endDate")}</div>
                    <div id="p-end" class="font-bold tracking-tight">
                      &mdash;
                    </div>
                  </div>
                </div>
              </div>

              <p
                id="p-excerpt"
                data-empty="true"
                class="preview-slot mt-6 pt-6 border-t border-gray-100 text-sm leading-relaxed break-words"
              >
                {t("intake.previewExcerpt")}
              </p>

              <div
                id="p-story"
                data-empty="true"
                class="preview-slot mt-4 text-sm leading-relaxed whitespace-pre-line break-words"
              >
                {t("intake.previewStory")}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="lg:col-span-7 lg:row-start-1">
        <div>
          <form id="intake-form" novalidate>
            {
              /* Honeypot — invisible to people and assistive tech. Bots fill
                it in and are dropped server-side, with no hint that they were. */
            }
            <div
              class="absolute -left-[9999px] h-px w-px overflow-hidden"
              aria-hidden="true"
            >
              <label for="company">Company</label>
              <input
                type="text"
                id="company"
                name="company"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <fieldset>
              <legend class={legend}>{t("intake.formHeading")}</legend>
              <div class="mt-6 space-y-6">
                <div>
                  <label for="f-title" class={label}>
                    {t("intake.title")}
                    <span class="text-qcRed" aria-hidden="true">*</span>
                  </label>
                  <p class={hint} id="h-title">{t("intake.titleHint")}</p>
                  <input
                    type="text"
                    id="f-title"
                    name="title"
                    aria-describedby="h-title"
                    maxlength={INTAKE_LIMITS.title}
                    required
                    class={input}
                    placeholder={t("intake.titlePlaceholder")}
                  />
                  <p class="field-error hidden mt-2 text-sm text-qcRed"></p>
                </div>

                <div>
                  <label for="f-organizer" class={label}>
                    {t("intake.organizer")}
                    <span class="text-qcRed" aria-hidden="true">*</span>
                  </label>
                  <p class={hint} id="h-organizer">
                    {t("intake.organizerHint")}
                  </p>
                  <input
                    type="text"
                    id="f-organizer"
                    name="organizer"
                    aria-describedby="h-organizer"
                    autocomplete="name"
                    maxlength={INTAKE_LIMITS.organizer}
                    required
                    class={input}
                    placeholder={t("intake.organizerPlaceholder")}
                  />
                  <p class="field-error hidden mt-2 text-sm text-qcRed"></p>
                </div>

                <div>
                  <label for="f-excerpt" class={label}>
                    {t("intake.excerpt")}
                    <span class="text-qcRed" aria-hidden="true">*</span>
                  </label>
                  <p class={hint} id="h-excerpt">{t("intake.excerptHint")}</p>
                  <textarea
                    id="f-excerpt"
                    name="excerpt"
                    aria-describedby="h-excerpt"
                    rows="3"
                    maxlength={INTAKE_LIMITS.excerpt}
                    required
                    class={`${input} resize-none`}
                    placeholder={t("intake.excerptPlaceholder")}></textarea>
                  <div class="flex items-start justify-between gap-4">
                    <p class="field-error hidden mt-2 text-sm text-qcRed"></p>
                    <p
                      id="excerpt-count"
                      class="mt-2 ml-auto text-xs text-gray-400 tabular-nums"
                    >
                      0 / {INTAKE_LIMITS.excerpt}
                    </p>
                  </div>
                </div>
              </div>
            </fieldset>

            <fieldset class={groupGap}>
              <legend class={legend}>{t("intake.groupTarget")}</legend>
              <div class="mt-6 grid sm:grid-cols-2 gap-6">
                <div>
                  <label for="f-goal" class={label}>
                    {t("intake.goal")}
                    <span class="text-qcRed" aria-hidden="true">*</span>
                  </label>
                  <p class={hint} id="h-goal">{t("intake.goalHint")}</p>
                  <div class="relative">
                    <span
                      class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none"
                      aria-hidden="true">&euro;</span
                    >
                    <input
                      type="number"
                      id="f-goal"
                      name="goalAmount"
                      aria-describedby="h-goal"
                      min="1"
                      step="1"
                      max={INTAKE_LIMITS.maxGoal}
                      required
                      class={`${input} !pl-9 tabular-nums`}
                      placeholder="2500"
                    />
                  </div>
                  <p class="field-error hidden mt-2 text-sm text-qcRed"></p>
                </div>

                <div>
                  <label for="f-end" class={label}>
                    {t("intake.endDate")}
                    <span class="text-qcRed" aria-hidden="true">*</span>
                  </label>
                  <p class={hint} id="h-end">{t("intake.endDateHint")}</p>
                  <input
                    type="date"
                    id="f-end"
                    name="endDate"
                    aria-describedby="h-end"
                    required
                    min={minEndValue}
                    value={defaultEndValue}
                    class={input}
                  />
                  <p class="field-error hidden mt-2 text-sm text-qcRed"></p>
                </div>
              </div>
            </fieldset>

            <fieldset class={groupGap}>
              <legend class={legend}>{t("intake.groupStory")}</legend>
              <div class="mt-6">
                <label for="f-story" class={label}>
                  {t("intake.story")}
                  <span class="text-qcRed" aria-hidden="true">*</span>
                </label>
                <p class={hint} id="h-story">{t("intake.storyHint")}</p>
                <div
                  class="rounded-xl border border-gray-200 bg-white focus-within:ring-2 focus-within:ring-qcRed/30 focus-within:border-qcRed transition-all overflow-hidden"
                >
                  <div
                    class="flex flex-wrap items-center gap-1 border-b border-gray-100 bg-gray-50 px-2 py-2"
                    role="toolbar"
                    aria-label={t("intake.toolbarLabel")}
                    aria-controls="f-story"
                  >
                    {
                      /* B, I and H are letterforms, which is what a text
                        toolbar has always used; the rest are drawn icons
                        from the site's own set, never a stand-in glyph. */
                    }
                    <button
                      type="button"
                      data-fmt="bold"
                      title={t("intake.fmtBold")}
                      aria-label={t("intake.fmtBold")}
                      class={fmtBtn + " font-bold"}
                    >
                      B
                    </button>
                    <button
                      type="button"
                      data-fmt="italic"
                      title={t("intake.fmtItalic")}
                      aria-label={t("intake.fmtItalic")}
                      class={fmtBtn + " italic font-serif"}
                    >
                      I
                    </button>
                    <button
                      type="button"
                      data-fmt="heading"
                      title={t("intake.fmtHeading")}
                      aria-label={t("intake.fmtHeading")}
                      class={fmtBtn + " font-bold"}
                    >
                      H
                    </button>
                    <span class="w-px h-5 bg-gray-200 mx-1" aria-hidden="true"
                    ></span>
                    <button
                      type="button"
                      data-fmt="list"
                      title={t("intake.fmtList")}
                      aria-label={t("intake.fmtList")}
                      class={fmtBtn}
                    >
                      <svg
                        viewBox="0 0 16 16"
                        class="w-4 h-4"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <circle cx="2" cy="4" r="1.4"></circle>
                        <circle cx="2" cy="8" r="1.4"></circle>
                        <circle cx="2" cy="12" r="1.4"></circle>
                        <rect x="5.5" y="3.25" width="10" height="1.5" rx="0.75"
                        ></rect>
                        <rect x="5.5" y="7.25" width="10" height="1.5" rx="0.75"
                        ></rect>
                        <rect
                          x="5.5"
                          y="11.25"
                          width="10"
                          height="1.5"
                          rx="0.75"></rect>
                      </svg>
                    </button>
                    <button
                      type="button"
                      data-fmt="link"
                      title={t("intake.fmtLink")}
                      aria-label={t("intake.fmtLink")}
                      class={fmtBtn}
                    >
                      <Icon name="link" class="text-[15px]" />
                    </button>
                    <button
                      type="button"
                      data-fmt="quote"
                      title={t("intake.fmtQuote")}
                      aria-label={t("intake.fmtQuote")}
                      class={fmtBtn}
                    >
                      <Icon name="quote-left" class="text-[13px]" />
                    </button>
                  </div>
                  <textarea
                    id="f-story"
                    name="story"
                    aria-describedby="h-story"
                    rows="14"
                    maxlength={INTAKE_LIMITS.story}
                    required
                    class="w-full px-4 py-3 bg-white text-qcBlack placeholder-gray-500 focus:outline-none resize-y"
                    placeholder={t("intake.storyPlaceholder")}></textarea>
                </div>
                <p class="field-error hidden mt-2 text-sm text-qcRed"></p>
              </div>
            </fieldset>

            <fieldset class={groupGap}>
              <legend class={legend}>{t("intake.groupPhoto")}</legend>
              <div class="mt-6 space-y-6">
                <div>
                  <label for="f-photo" class={label}>
                    {t("intake.photo")}
                    <span class="text-qcRed" aria-hidden="true">*</span>
                  </label>
                  <p class={hint} id="h-photo">{t("intake.photoHint")}</p>
                  <input
                    type="file"
                    id="f-photo"
                    name="photo"
                    aria-describedby="h-photo"
                    accept="image/jpeg,image/png,image/webp"
                    required
                    class="w-full text-sm text-gray-500 rounded-xl border border-gray-200 file:mr-4 file:py-3 file:px-5 file:rounded-l-xl file:border-0 file:text-sm file:font-semibold file:bg-qcRed/10 file:text-qcRed hover:file:bg-qcRed/20 file:cursor-pointer cursor-pointer focus:outline-none focus:ring-2 focus:ring-qcRed/30 focus:border-qcRed transition-all"
                  />
                  <p class="field-error hidden mt-2 text-sm text-qcRed"></p>
                </div>

                <div>
                  <label for="f-photo-alt" class={label}>
                    {t("intake.photoAlt")}
                  </label>
                  <p class={hint} id="h-photo-alt">
                    {t("intake.photoAltHint")}
                  </p>
                  <input
                    type="text"
                    id="f-photo-alt"
                    name="photoAlt"
                    aria-describedby="h-photo-alt"
                    maxlength={INTAKE_LIMITS.photoAlt}
                    class={input}
                    placeholder={t("intake.photoAltPlaceholder")}
                  />
                </div>

                <div>
                  <label for="f-files" class={label}>
                    {t("intake.files")}
                    <span class="text-gray-400 font-normal">
                      &middot; {t("intake.optional")}
                    </span>
                  </label>
                  <p class={hint} id="h-files">{t("intake.filesHint")}</p>
                  <input
                    type="file"
                    id="f-files"
                    name="attachments"
                    aria-describedby="h-files"
                    multiple
                    accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml,application/pdf"
                    class="w-full text-sm text-gray-500 rounded-xl border border-gray-200 file:mr-4 file:py-3 file:px-5 file:rounded-l-xl file:border-0 file:text-sm file:font-semibold file:bg-gray-100 file:text-qcBlack hover:file:bg-gray-200 file:cursor-pointer cursor-pointer focus:outline-none focus:ring-2 focus:ring-qcRed/30 focus:border-qcRed transition-all"
                  />
                  <ul
                    id="file-list"
                    class="mt-3 space-y-1.5 text-sm text-gray-600 empty:mt-0"
                  >
                  </ul>
                  <p class="field-error hidden mt-2 text-sm text-qcRed"></p>
                </div>
              </div>
            </fieldset>

            <fieldset class={groupGap}>
              <legend class={legend}>{t("intake.groupContact")}</legend>
              <div class="mt-6 grid sm:grid-cols-2 gap-6">
                <div>
                  <label for="f-email" class={label}>
                    {t("intake.email")}
                    <span class="text-qcRed" aria-hidden="true">*</span>
                  </label>
                  <p class={hint} id="h-email">{t("intake.emailHint")}</p>
                  <input
                    type="email"
                    id="f-email"
                    name="email"
                    aria-describedby="h-email"
                    autocomplete="email"
                    maxlength={INTAKE_LIMITS.email}
                    required
                    class={input}
                    placeholder={t("intake.emailPlaceholder")}
                  />
                  <p class="field-error hidden mt-2 text-sm text-qcRed"></p>
                </div>

                <div>
                  <label for="f-lang" class={label}>
                    {t("intake.language")}
                  </label>
                  <p class={hint} id="h-lang">{t("intake.languageHint")}</p>
                  <select
                    id="f-lang"
                    name="lang"
                    aria-describedby="h-lang"
                    class={input}
                  >
                    <option value="nl" selected={lang === "nl"}
                      >Nederlands</option
                    >
                    <option value="en" selected={lang === "en"}>English</option>
                    <option value="es" selected={lang === "es"}>Español</option>
                  </select>
                </div>
              </div>
            </fieldset>

            <div
              class="mt-14 pt-8 border-t border-gray-100 space-y-4 text-sm text-gray-500"
            >
              <p class="flex gap-3">
                <Icon name="users" class="text-gray-400 mt-1 flex-shrink-0" />
                <span>{t("intake.publishedNotice")}</span>
              </p>
              <p class="flex gap-3">
                <Icon name="heart" class="text-gray-400 mt-1 flex-shrink-0" />
                <span>{t("intake.fundsNotice")}</span>
              </p>
            </div>

            <button
              type="submit"
              class="intake-btn qc-btn qc-btn--primary mt-8 w-full sm:w-auto px-10 py-4 text-base"
            >
              <span class="intake-btn-text">
                <Icon name="paper-plane" class="mr-2" />{t("intake.submit")}
              </span>
              <span class="intake-btn-sending !hidden">
                <Icon name="spinner" class="mr-2 animate-spin" />{
                  t("intake.submitting")
                }
              </span>
            </button>

            <p
              class="intake-form-error hidden mt-4 text-sm font-semibold text-qcRed"
              role="alert"
            >
            </p>

            <p class="mt-8 text-xs text-gray-500">
              {t("intake.privacyNotice")}{" "}
              <a
                href={privacyPath}
                class="underline decoration-dotted underline-offset-4 text-qcRed hover:decoration-solid"
              >
                {t("intake.privacyLink")}
              </a>.
            </p>
          </form>

          <!-- Replaces the form once the submission is through. The preview
               stays put, so they still see what they just sent. -->
          <div id="intake-success" class="hidden">
            <div
              class="rounded-xl border border-green-200 bg-green-50 p-8 text-center"
            >
              <div
                class="w-14 h-14 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-5"
              >
                <Icon name="check" class="text-2xl text-green-700" />
              </div>
              <h2 class="text-xl font-bold tracking-tight text-green-900 mb-3">
                {t("intake.successHeading")}
              </h2>
              <p class="text-green-800 leading-relaxed max-w-md mx-auto">
                {t("intake.successBody")}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* A preview slot holds either the visitor's words or the example text
     standing in for them. One rule keeps the two states apart, so the
     script only has to flip an attribute. */
  .preview-slot {
    color: var(--color-qcBlack, #111);
  }
  .preview-slot[data-empty="true"] {
    color: var(--color-gray-300, #d1d5db);
  }
  #p-excerpt:not([data-empty="true"]),
  #p-story:not([data-empty="true"]) {
    color: var(--color-gray-600, #4b5563);
  }

  /* The card scrolls inside itself once a long story outgrows the
     viewport, so the sticky column cannot push its own top out of reach. */
  .preview-scroll {
    scrollbar-width: thin;
    scrollbar-color: var(--color-gray-300, #d1d5db) transparent;
  }
  .preview-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .preview-scroll::-webkit-scrollbar-thumb {
    background: var(--color-gray-300, #d1d5db);
    border-radius: 9999px;
  }

  @media (prefers-reduced-motion: reduce) {
    #p-photo {
      transition: none;
    }
  }
</style>

<script
  is:inline
  id="intake-messages"
  type="application/json"
  set:html={JSON.stringify(messages)}
/>
<script
  is:inline
  id="intake-placeholders"
  type="application/json"
  set:html={JSON.stringify({
    title: t("intake.previewTitle"),
    organizer: t("intake.previewOrganizer"),
    excerpt: t("intake.previewExcerpt"),
    story: t("intake.previewStory"),
    formError: t("intake.error"),
    fixErrors: t("intake.fixErrors"),
    minWidth: INTAKE_LIMITS.minImageWidth,
    maxBytes: INTAKE_LIMITS.maxImageBytes,
    excerptMax: INTAKE_LIMITS.excerpt,
    maxFiles: INTAKE_LIMITS.maxAttachments,
    maxFileBytes: INTAKE_LIMITS.maxAttachmentBytes,
    maxFilesTotalBytes: INTAKE_LIMITS.maxAttachmentTotalBytes,
    fmtSample: t("intake.fmtSample"),
  })}
/>

<script>
  // Time-trap: bots submit a rendered form almost instantly.
  const loadedAt = Date.now();

  const formEl = document.getElementById(
    "intake-form",
  ) as HTMLFormElement | null;

  if (formEl) {
    const form = formEl;
    const read = (id: string) =>
      JSON.parse(document.getElementById(id)!.textContent || "{}");
    const MSG: Record<string, string> = read("intake-messages");
    const PH = read("intake-placeholders");

    const $ = <T extends HTMLElement>(id: string) =>
      document.getElementById(id) as T;

    const preview = {
      title: $<HTMLElement>("p-title"),
      organizer: $<HTMLElement>("p-organizer"),
      excerpt: $<HTMLElement>("p-excerpt"),
      story: $<HTMLElement>("p-story"),
      raised: $<HTMLElement>("p-raised"),
      goal: $<HTMLElement>("p-goal"),
      days: $<HTMLElement>("p-days"),
      end: $<HTMLElement>("p-end"),
      photo: $<HTMLImageElement>("p-photo"),
      photoEmpty: $<HTMLElement>("p-photo-empty"),
    };

    const locale = $<HTMLElement>("preview-card").dataset.locale || "nl-NL";
    const money = new Intl.NumberFormat(locale, {
      style: "currency",
      currency: "EUR",
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    });
    const longDate = new Intl.DateTimeFormat(locale, {
      day: "numeric",
      month: "long",
      year: "numeric",
    });

    /**
     * The example text lives in the same element as the real value, so the
     * preview never reflows as a field is filled in — only its colour
     * changes, which the stylesheet handles off the data-empty flag.
     */
    function put(el: HTMLElement, value: string, placeholder: string) {
      const filled = value.trim() !== "";
      el.textContent = filled ? value : placeholder;
      el.dataset.empty = filled ? "false" : "true";
    }

    const field = (name: string) =>
      form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;

    const escapeHtml = (text: string) =>
      text.replace(
        /[&<>"]/g,
        (c) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] ?? c,
      );

    /**
     * Render the subset of Markdown the toolbar can produce.
     *
     * Deliberately not a Markdown library: the toolbar writes the syntax,
     * so the preview only has to read back what it wrote, and shipping a
     * parser to every visitor to re-read six constructs is not a trade
     * worth making. Everything is escaped before any tag is added — the
     * text is the visitor's own, but it still must not be able to inject
     * markup into the page rendering it.
     */
    function renderMarkdown(src: string): string {
      const inline = (text: string) =>
        escapeHtml(text)
          .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
          .replace(/(^|[^*])\*([^*]+)\*/g, "$1<em>$2</em>")
          .replace(
            /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
            '<a href="$2" class="text-qcRed underline">$1</a>',
          );

      const html: string[] = [];
      let list: string[] = [];

      const flush = () => {
        if (!list.length) return;
        html.push(
          `<ul class="list-disc pl-5 space-y-1 my-3">${list.join("")}</ul>`,
        );
        list = [];
      };

      for (const raw of src.split(/\n{2,}/)) {
        const block = raw.trim();
        if (!block) continue;

        const lines = block.split("\n");
        if (lines.every((l) => /^\s*[-*]\s+/.test(l))) {
          for (const l of lines) {
            list.push(`<li>${inline(l.replace(/^\s*[-*]\s+/, ""))}</li>`);
          }
          flush();
          continue;
        }
        flush();

        const heading = block.match(/^(#{2,3})\s+(.*)$/);
        if (heading) {
          const tag = heading[1].length === 2 ? "h4" : "h5";
          html.push(
            `<${tag} class="font-bold tracking-tight text-qcBlack mt-4 mb-1">${inline(heading[2])}</${tag}>`,
          );
          continue;
        }

        if (/^>\s?/.test(block)) {
          html.push(
            `<blockquote class="border-l-2 border-gray-200 pl-3 italic my-3">${inline(
              block.replace(/^>\s?/gm, ""),
            )}</blockquote>`,
          );
          continue;
        }

        html.push(
          `<p class="my-3">${inline(block).replace(/\n/g, "<br>")}</p>`,
        );
      }
      flush();
      return html.join("");
    }

    // --- formatting toolbar ------------------------------------------
    const story = $<HTMLTextAreaElement>("f-story");

    /** Wrap the selection, or drop a marker the visitor types over. */
    function applyFormat(cmd: string) {
      const start = story.selectionStart;
      const end = story.selectionEnd;
      const selected = story.value.slice(start, end);
      const sample = selected || PH.fmtSample;
      let replacement = sample;
      let caret = 0;

      if (cmd === "bold") replacement = `**${sample}**`;
      else if (cmd === "italic") replacement = `*${sample}*`;
      else if (cmd === "heading") replacement = `## ${sample}`;
      else if (cmd === "quote") replacement = `> ${sample}`;
      else if (cmd === "link") {
        replacement = `[${sample}](https://)`;
        caret = replacement.length - 1;
      } else if (cmd === "list") {
        replacement = sample
          .split("\n")
          .map((l: string) => `- ${l.replace(/^[-*]\s*/, "")}`)
          .join("\n");
      }

      // Block-level marks need to start on their own line.
      const needsBreak =
        ["heading", "quote", "list"].includes(cmd) &&
        start > 0 &&
        story.value[start - 1] !== "\n";
      if (needsBreak) replacement = `\n\n${replacement}`;

      story.setRangeText(replacement, start, end, "end");
      if (caret) {
        const at = start + (needsBreak ? 2 : 0) + caret;
        story.setSelectionRange(at, at);
      } else if (!selected) {
        // Leave the sample word selected so typing replaces it.
        const from =
          start +
          (needsBreak ? 2 : 0) +
          replacement.indexOf(sample) -
          (needsBreak ? 2 : 0);
        story.setSelectionRange(from, from + sample.length);
      }
      story.focus();
      story.dispatchEvent(new Event("input", { bubbles: true }));
    }

    form.querySelectorAll<HTMLButtonElement>("[data-fmt]").forEach((btn) => {
      // mousedown, not click: the textarea must keep its selection.
      btn.addEventListener("mousedown", (e) => {
        e.preventDefault();
        applyFormat(btn.dataset.fmt!);
      });
    });

    story.addEventListener("keydown", (e) => {
      if (!(e.ctrlKey || e.metaKey)) return;
      const key = e.key.toLowerCase();
      if (key !== "b" && key !== "i") return;
      e.preventDefault();
      applyFormat(key === "b" ? "bold" : "italic");
    });

    function render() {
      put(preview.title, field("title").value, PH.title);
      put(preview.organizer, field("organizer").value, PH.organizer);
      put(preview.excerpt, field("excerpt").value, PH.excerpt);

      const story = field("story").value;
      if (story.trim() === "") {
        preview.story.textContent = PH.story;
        preview.story.dataset.empty = "true";
      } else {
        preview.story.innerHTML = renderMarkdown(story);
        preview.story.dataset.empty = "false";
      }

      const goal = Number(field("goalAmount").value);
      preview.goal.textContent = money.format(
        Number.isFinite(goal) && goal > 0 ? goal : 0,
      );
      preview.raised.textContent = money.format(0);

      const endValue = field("endDate").value;
      if (endValue) {
        const end = new Date(`${endValue}T23:59:59`);
        preview.end.textContent = longDate.format(end);
        preview.days.textContent = String(
          Math.max(0, Math.ceil((end.getTime() - Date.now()) / 86400000)),
        );
      } else {
        preview.end.textContent = "—";
        preview.days.textContent = "0";
      }

      const count = document.getElementById("excerpt-count");
      if (count) {
        count.textContent = `${field("excerpt").value.length} / ${PH.excerptMax}`;
      }
    }

    // One listener for the whole form: every field feeds the preview.
    form.addEventListener("input", render);
    form.addEventListener("change", render);
    render();

    // Which part of the preview each field is responsible for.
    const FOCUS_TARGET: Record<string, string> = {
      title: "p-title",
      organizer: "p-organizer",
      excerpt: "p-excerpt",
      story: "p-story",
      goalAmount: "p-goal",
      endDate: "p-end",
      photo: "p-photo-empty",
      photoAlt: "p-photo-empty",
    };
    const card = $<HTMLElement>("preview-card");
    const stillMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    form.addEventListener("focusin", (e) => {
      const name = (e.target as HTMLElement).getAttribute("name") ?? "";
      const target = document.getElementById(FOCUS_TARGET[name] ?? "");
      if (!target || card.scrollHeight <= card.clientHeight) return;
      const offset =
        target.getBoundingClientRect().top - card.getBoundingClientRect().top;
      card.scrollTo({
        top: card.scrollTop + offset - 24,
        behavior: stillMotion.matches ? "auto" : "smooth",
      });
    });

    // --- photo -------------------------------------------------------
    const photoInput = $<HTMLInputElement>("f-photo");
    let objectUrl: string | null = null;

    function clearPhoto() {
      preview.photo.classList.add("opacity-0");
      preview.photoEmpty.classList.remove("hidden");
    }

    photoInput.addEventListener("change", () => {
      const file = photoInput.files?.[0];
      clearError(photoInput);

      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = null;

      if (!file) {
        clearPhoto();
        return;
      }

      if (file.size > PH.maxBytes) {
        showError(photoInput, MSG["photo.too-large"]);
        photoInput.value = "";
        clearPhoto();
        return;
      }

      objectUrl = URL.createObjectURL(file);
      // Measure before showing it. A photo too small to print sharply is
      // the most common reason a fundraiser stalls, and saying so now is
      // far cheaper than an email a week later.
      const probe = new Image();
      probe.onload = () => {
        if (probe.naturalWidth < PH.minWidth) {
          showError(photoInput, MSG["photo.too-small"]);
          photoInput.value = "";
          clearPhoto();
          return;
        }
        preview.photo.src = objectUrl!;
        preview.photo.classList.remove("opacity-0");
        preview.photoEmpty.classList.add("hidden");
      };
      probe.onerror = () => {
        showError(photoInput, MSG["photo.unreadable"]);
        photoInput.value = "";
        clearPhoto();
      };
      probe.src = objectUrl;
    });

    // Keep the preview's alt text honest — it is what a screen reader
    // would announce on the published page.
    const altInput = $<HTMLInputElement>("f-photo-alt");
    altInput.addEventListener("input", () => {
      preview.photo.alt = altInput.value;
    });

    // --- extra files -------------------------------------------------
    const filesInput = $<HTMLInputElement>("f-files");
    const fileList = $<HTMLElement>("file-list");

    filesInput.addEventListener("change", () => {
      clearError(filesInput);
      fileList.innerHTML = "";

      const picked = Array.from(filesInput.files ?? []);
      if (picked.length > PH.maxFiles) {
        showError(filesInput, MSG["attachments.too-many"]);
        filesInput.value = "";
        return;
      }

      let total = 0;
      for (const file of picked) total += file.size;
      if (
        total > PH.maxFilesTotalBytes ||
        picked.some((f) => f.size > PH.maxFileBytes)
      ) {
        showError(filesInput, MSG["attachments.too-large"]);
        filesInput.value = "";
        return;
      }

      for (const file of picked) {
        const li = document.createElement("li");
        li.className = "flex items-baseline gap-2";
        const name = document.createElement("span");
        name.className = "truncate";
        name.textContent = file.name;
        const size = document.createElement("span");
        size.className =
          "ml-auto flex-shrink-0 text-xs text-gray-400 tabular-nums";
        size.textContent = `${Math.max(1, Math.round(file.size / 1024))} kB`;
        li.append(name, size);
        fileList.append(li);
      }
    });

    // --- errors ------------------------------------------------------
    function errorEl(el: HTMLElement): HTMLElement | null {
      return (
        el.closest("div")?.querySelector<HTMLElement>(".field-error") ?? null
      );
    }

    function showError(el: HTMLElement, message: string) {
      const target = errorEl(el);
      if (!target) return;
      target.textContent = message;
      target.classList.remove("hidden");
      el.classList.add("!border-qcRed");
      el.setAttribute("aria-invalid", "true");
    }

    function clearError(el: HTMLElement) {
      const target = errorEl(el);
      if (target) target.classList.add("hidden");
      el.classList.remove("!border-qcRed");
      el.removeAttribute("aria-invalid");
    }

    function clearAllErrors() {
      form
        .querySelectorAll<HTMLElement>(".field-error")
        .forEach((el) => el.classList.add("hidden"));
      form
        .querySelectorAll<HTMLElement>("[aria-invalid]")
        .forEach((el) => clearError(el));
    }

    // --- submit ------------------------------------------------------
    const btn = form.querySelector<HTMLButtonElement>(".intake-btn")!;
    const btnText = form.querySelector<HTMLElement>(".intake-btn-text")!;
    const btnSending = form.querySelector<HTMLElement>(".intake-btn-sending")!;
    const formError = form.querySelector<HTMLElement>(".intake-form-error")!;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearAllErrors();
      formError.classList.add("hidden");

      const data = new FormData(form);
      data.set("elapsedMs", String(Date.now() - loadedAt));

      btn.disabled = true;
      btnText.classList.add("!hidden");
      btnSending.classList.remove("!hidden");

      try {
        const res = await fetch("/api/fundraisers/intake", {
          method: "POST",
          body: data,
        });
        const payload = await res.json().catch(() => ({}));

        if (!res.ok) {
          let first: HTMLElement | null = null;
          if (payload.fields) {
            for (const [name, code] of Object.entries(
              payload.fields as Record<string, string>,
            )) {
              const el = form.elements.namedItem(name) as HTMLElement | null;
              if (el) {
                showError(el, MSG[`${name}.${code}`] || MSG.fallback);
                first = first ?? el;
              }
            }
            formError.textContent = PH.fixErrors;
          } else {
            formError.textContent = PH.formError;
          }
          formError.classList.remove("hidden");
          // Send them to the field that needs fixing, not to the footer.
          (first ?? formError).scrollIntoView({
            behavior: "smooth",
            block: "center",
          });
          first?.focus({ preventScroll: true });
          return;
        }

        form.classList.add("hidden");
        const success = document.getElementById("intake-success")!;
        success.classList.remove("hidden");
        success.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch {
        formError.textContent = PH.formError;
        formError.classList.remove("hidden");
      } finally {
        btn.disabled = false;
        btnText.classList.remove("!hidden");
        btnSending.classList.add("!hidden");
      }
    });
  }
</script>
