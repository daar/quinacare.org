---
interface Props {
  dataUri: string;
  alt?: string;
  size?: "sm" | "md" | "lg";
  downloadFilename?: string;
}

const {
  dataUri,
  alt = "QR code",
  size = "md",
  downloadFilename = "quinacare-qr.png",
} = Astro.props;

const sizeClasses = {
  sm: "w-16 h-16",
  md: "w-24 h-24 md:w-32 md:h-32",
  lg: "w-32 h-32 md:w-48 md:h-48",
};
---

<a
  href={dataUri}
  download={downloadFilename}
  class="inline-block transition-transform hover:scale-110 active:scale-95"
  aria-label={`Download ${alt}`}
>
  <img
    src={dataUri}
    alt={alt}
    class:list={[sizeClasses[size], "rounded-lg shadow-lg"]}
  />
</a>
