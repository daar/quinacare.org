---
import Icon from "./Icon.astro";
import type { Hub, Subscriber } from "../data/putumayoLoop";
import { useTranslations, getDateLocale, type Lang } from "../i18n";
import { countryName } from "../lib/countryName";

interface Props {
  lang: Lang;
  hubs: Hub[];
  subscribers: Subscriber[];
  donationItems?: Array<{
    amount_cents: number;
    firstName?: string;
    donatedAt: string;
  }>;
}
const { lang, hubs, subscribers, donationItems = [] } = Astro.props;
const t = useTranslations(lang);
const dateLocale = getDateLocale(lang);

const hubsById = new Map(hubs.map((h) => [h.id, h]));

// Merge signups and donations into activity timeline
const activities = [
  ...subscribers.map((s) => ({
    type: "signup" as const,
    data: s,
    timestamp: s.signedUpAt,
  })),
  ...donationItems.map((d) => ({
    type: "donation" as const,
    data: d,
    timestamp: d.donatedAt,
  })),
]
  .sort(
    (a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime(),
  )
  .slice(0, 50);

function relTime(iso: string): string {
  const then = new Date(iso).getTime();
  const now = Date.now();
  const diffMin = Math.round((now - then) / (1000 * 60));
  const rtf = new Intl.RelativeTimeFormat(dateLocale, { numeric: "auto" });
  if (diffMin < 60) return rtf.format(-diffMin, "minute");
  const diffH = Math.round(diffMin / 60);
  if (diffH < 24) return rtf.format(-diffH, "hour");
  return rtf.format(-Math.round(diffH / 24), "day");
}
---

<div
  class="rounded-xl border border-gray-100 bg-white shadow-sm h-full flex flex-col"
  style="min-height: 420px;"
>
  <div class="p-4 border-b border-gray-100">
    <span class="qc-label">{t("putumayoLoop.activityTimeline")}</span>
  </div>
  <ul
    class="flex-1 overflow-y-auto divide-y divide-gray-50"
    style="max-height: 360px;"
  >
    {
      activities.map((activity) => {
        if (activity.type === "signup") {
          const s = activity.data;
          const hub = s.hubId ? hubsById.get(s.hubId) : null;
          const name = s.firstName ?? "";
          const place = hub
            ? `${hub.city}, ${countryName(hub.country, lang)}`
            : (s.location ?? "—");
          const text = t("putumayoLoop.signedUp")
            .replace("{name}", name)
            .replace("{place}", place);
          return (
            <li class="flex items-start gap-3 px-4 py-3">
              <span class="w-8 h-8 rounded-full bg-red-50 text-qcRed flex items-center justify-center flex-shrink-0">
                <Icon name="heart" class="text-xs" />
              </span>
              <div class="min-w-0 flex-1">
                <p class="qc-body text-sm leading-snug">{text}</p>
                <p class="qc-meta mt-0.5">{relTime(s.signedUpAt)}</p>
              </div>
            </li>
          );
        } else {
          const d = activity.data;
          const name = d.firstName ?? "Iemand";
          const amount = `€${Math.round(d.amount_cents / 100)}`;
          const donatedText = t("putumayoLoop.donated")
            .replace("{name}", name)
            .replace("{amount}", amount);
          const thankYouText = t("putumayoLoop.donatedThankYou");
          return (
            <li class="flex items-start gap-3 px-4 py-3">
              <span class="w-8 h-8 rounded-full bg-red-50 text-qcRed flex items-center justify-center flex-shrink-0">
                <Icon name="hand-holding-heart" class="text-xs" />
              </span>
              <div class="min-w-0 flex-1">
                <p class="qc-body text-sm leading-snug">
                  {donatedText}. {thankYouText}
                </p>
                <p class="qc-meta mt-0.5">{relTime(d.donatedAt)}</p>
              </div>
            </li>
          );
        }
      })
    }
  </ul>
</div>
