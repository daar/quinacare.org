{
  "name": "quinacare.org",
  "type": "module",
  "version": "0.0.1",
  "description": "Website of Stichting Quina Care - medical care for the most remote areas of the Amazon.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run svg:minify && astro dev",
    "build": "npm run svg:minify && astro build && npx pagefind --site dist",
    "check": "astro check",
    "lint": "eslint .",
    "spellcheck": "cspell \"src/content/**/*.mdoc\"",
    "format:check": "prettier --check .",
    "svg:minify": "svgo -r --folder src/assets --quiet --exclude instagram.svg --exclude Asset-2.svg && svgo -r --folder public --quiet --exclude favicon.svg",
    "check:images": "node scripts/check-image-sizes.mjs",
    "resize:images": "node scripts/resize-images.mjs",
    "check:translations": "node scripts/missing-translations-report.mjs",
    "check:links": "linkinator dist --config .linkinator.json",
    "lighthouse": "npx --yes @lhci/cli@0.14.0 autorun",
    "mollie-admin": "node --env-file=.env tools/mollie-admin/server.mjs",
    "test": "node --test --experimental-strip-types 'tests/*.test.ts'",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "overrides": {
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@astrojs/markdoc": "^2.0.8",
    "@astrojs/netlify": "^8.2.4",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.6.3",
    "@libsql/client": "^0.17.3",
    "@mollie/api-client": "^4.5.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.2.6",
    "leaflet": "^1.9.4",
    "lodash-es": "^4.18.1",
    "nodemailer": "^9.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "swiper": "^14.1.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cspell/dict-es-es": "^3.0.8",
    "@cspell/dict-nl-nl": "^2.4.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/lodash-es": "^4.17.12",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "cspell": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^3.1.0",
    "husky": "^9.1.7",
    "linkinator": "^8.0.3",
    "lint-staged": "^17.0.7",
    "patch-package": "^8.0.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "svgo": "^4.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,json,css,md}": "prettier --write",
    "*.astro": "prettier --write --plugin prettier-plugin-astro",
    "*.mdoc": "cspell --no-must-find-files"
  }
}
